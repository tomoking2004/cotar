{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/papers/pcsj-imps-2026/check.py\" --hook",
            "timeout": 120,
            "statusMessage": "予稿の書式を検査しています"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n' 'この会話は要約（圧縮）された．CLAUDE.md「頼まれた作業は原則ひとつのセッションで確定版まで済ませる」の徴候に当たる．次の応答の冒頭で本人にそう告げ，同節の形で別セッションへの委譲を提案する．本人が続けるよう言えば，このセッションで続ける．'"
          }
        ]
      }
    ]
  }
}
